@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard">

    <!-- Dashboard Header -->
    <div class="dashboard-header">

        <div>
            <p class="dashboard-eyebrow">YOUR JOB SEARCH</p>
            <h1>Dashboard</h1>
            <p class="dashboard-subtitle">
                Keep track of your applications and stay on top of your job search.
            </p>
        </div>

        <a href="#" class="add-application-btn">
            <span>+</span> Add Application
        </a>

    </div>


    <!-- Statistics -->
    <div class="dashboard-stats">

        <div class="stat-card">
            <div class="stat-card-top">
                <p>Total Applications</p>
                <span class="stat-icon">▣</span>
            </div>

            <h2>0</h2>
            <p class="stat-description">Applications tracked</p>
        </div>


        <div class="stat-card">
            <div class="stat-card-top">
                <p>Applied</p>
                <span class="stat-icon">↗</span>
            </div>

            <h2>0</h2>
            <p class="stat-description">Applications submitted</p>
        </div>


        <div class="stat-card">
            <div class="stat-card-top">
                <p>Interviews</p>
                <span class="stat-icon">◷</span>
            </div>

            <h2>0</h2>
            <p class="stat-description">Interview stages</p>
        </div>


        <div class="stat-card">
            <div class="stat-card-top">
                <p>Offers</p>
                <span class="stat-icon">✓</span>
            </div>

            <h2>0</h2>
            <p class="stat-description">Offers received</p>
        </div>

    </div>


    <!-- Recent Applications -->
    <div class="applications-section">

        <div class="section-header">

            <div>
                <h2>Recent Applications</h2>
                <p>Keep an eye on your latest applications.</p>
            </div>

            <a href="#" class="view-all-link">
                View All →
            </a>

        </div>


        <!-- Empty State -->
        <div class="empty-state">

            <div class="empty-state-icon">
                +
            </div>

            <h3>No applications yet</h3>

            <p>
                You haven't added any job applications yet.
                Start building your application tracker by adding your first one.
            </p>

            <a href="#" class="empty-state-btn">
                Add Your First Application
            </a>

        </div>

    </div>

</div>