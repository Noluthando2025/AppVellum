@model IEnumerable<AppVellum.Models.Application>

@{
    ViewData["Title"] = "Applications";
}
<!--this page helps the user keep track of all their job applications.-->
<div class="applications-page">

    <div class="applications-header">
        <div>
            <h1>Applications</h1>
            <p>Keep track of every opportunity you're pursuing!</p>
        </div>

        <a href="#" class="btn-primary">+ Add Application</a>
    </div>

    <div class="applications-toolbar">

        <div class="search-box">
            <input type="text" placeholder="Search applications..." />
        </div>

        <div class="filter-options">
            <button class="filter-button">Filter</button>
            <button class="filter-button">Sort</button>
        </div>

    </div>

    <div class="applications-card">

        <div class="applications-table">

            <div class="table-header">
                <span>Company</span>
                <span>Job Title</span>
                <span>Status</span>
                <span>Applied</span>
                <span></span>
            </div>

            @if (Model.Any())
            {
                @foreach (var application in Model)
                {
                    <div class="application-row">
                        <span>
                            @(application.Company?.CompanyName ?? "Unknown company")
                        </span>

                        <span>@application.JobTitle</span>

                        <span>
                            <span class="status-badge @GetStatusClass(application.Status)">
                                @application.Status
                            </span>
                        </span>

                        <span>
                            @(application.DateApplied?.ToString("dd MMM yyyy") ?? "Not specified")
                        </span>

                        <span class="row-action">View</span>
                    </div>
                }
            }
            else
            {
                <div class="application-row">
                    <span>No applications yet</span>
                    <span>Add your first application to get started.</span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            }
        </div>

    </div>

</div>

@functions {
    public string GetStatusClass(string status)
    {
        return status switch
        {
            "Applied" => "status-applied",
            "Interview" => "status-interview",
            "Rejected" => "status-rejected",
            _ => ""
        };
    }
}